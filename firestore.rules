rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated single-family application. Client access is intentionally
    // limited to the fixed family; members documents and roles are not used.
    function isAppUser(familyId) {
      return request.auth != null && familyId == 'oomine-study-2026';
    }

    match /families/{familyId}/apps/junior-high/tasks/{taskId} {
      allow read, create, update, delete: if isAppUser(familyId);
    }

    match /families/{familyId}/apps/junior-high/tests/{testId} {
      allow read, create, update, delete: if isAppUser(familyId);
    }

    match /families/{familyId}/apps/junior-high/activeTimers/current {
      allow read, create, update, delete: if isAppUser(familyId);
    }

    match /families/{familyId}/apps/junior-high/studySessions/{sessionId} {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rewardLedger/{sessionId} {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rewardAdjustmentLedger/{adjustmentId} {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rewardIntegrity/current {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpg/playerProfile {
      // Client-side economy writes remain intentionally allowed for app users.
      // Moving these mutations to a trusted backend is required for strict anti-cheat.
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgProgress/current {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgQuestState/current {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgQuestLedger/{ledgerId} {
      allow read, create: if isAppUser(familyId);
      allow update, delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgActionLedger/{actionId} {
      allow read, create: if isAppUser(familyId);
      allow update, delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgExchangeLedger/{actionId} {
      allow read, create: if isAppUser(familyId);
      allow update, delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgBattles/{battleId} {
      allow read, create, update: if isAppUser(familyId);
      allow delete: if false;
    }

    match /families/{familyId}/apps/junior-high/rpgBattleLedger/{ledgerId} {
      allow read, create: if isAppUser(familyId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
